    {
      "id": "de01bde7-7d80-465b-9372-8c3a4ace14e4",
      "name": "Resolve CRM contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const incoming = $('Prepare lead').first().json;\nif (!incoming.message || !incoming.name || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(incoming.email)) throw new Error('Invalid lead fields');\nconst matches=$input.all().map(i=>i.json).filter(r=>r.crm_id);\nif(matches.length>1) throw new Error('Multiple historical contacts share this email; reconcile them first');\nconst old=matches[0];\nif(old && old.status==='pending_review' && old.message===incoming.message && old.company===incoming.company && old.name===incoming.name) return [];\nreturn [{json:old ? {...incoming,crm_id:old.crm_id,timestamp:old.timestamp,utm_source:old.utm_source,utm_campaign:old.utm_campaign} : incoming}];"
      },
      "position": [
        660,
        0
      ]
